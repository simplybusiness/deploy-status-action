{
  "name": "deploy-status-action",
  "version": "3.0.2",
  "description": "Check if the deployment is blocked",
  "main": "index.js",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:parity": "node src/test-utils/parity.js check",
    "prettier:check": "prettier --check .",
    "eslint:check": "eslint --max-warnings 0 \"**/*.js\"",
    "prettier:fix": "prettier --write .",
    "eslint:fix": "npm run eslint:check -- --fix",
    "prepare": "husky",
    "build": "ncc build index.js -o dist --license licenses.txt"
  },
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simplybusiness/deploy-status-action.git"
  },
  "keywords": [],
  "author": "simplybusiness",
  "bugs": {
    "url": "https://github.com/simplybusiness/deploy-status-action/issues"
  },
  "homepage": "https://github.com/simplybusiness/deploy-status-action#readme",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "bottleneck": "^2.19.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@vercel/ncc": "0.45.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.2",
    "prettier": "3.10.1"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  }
